{
  "ReverseProxy": {
    "Routes": {
      "minio-download-route": {
        "ClusterId": "minio-cluster",
        "Order": 35,
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/rednote-media/images/{**catch-all}",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "RequestHeaderOriginalHost": "true"
          }
        ]
      }
    }
  },
  "Diagnostics": {
    "GatewayDebug": {
      "Enabled": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "RateLimiting": {
    "SearchPermitsPerMinute": 600,
    "UploadPermitsPerMinute": 120,
    "AuthPermitsPerMinute": 120,
    "ApiPermitsPerMinute": 1200
  }
}
